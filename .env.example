# DO NOT commit the real .env. This file is a SAFE placeholder template.
# Copy to .env and fill with real values (kept out of git via .gitignore).

DATABASE_URL=
REDIS_URL=
NODE_ENV=
PORT=

# AI Providers
GEMINI_API_KEY=
GROQ_API_KEYS=

# GOWA (self-hosted WA gateway, admin use)
GOWA_API_URL=
GOWA_BASIC_AUTH_USER=
GOWA_BASIC_AUTH_PASS=

# Cloudinary (profile photo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backup
BACKUP_ENCRYPTION_KEY=
BACKUP_PROVIDER=
WEBHOOK_SECRET=
PUBLIC_API_URL=
# Public PWA / storefront base URL used to build storefront links (e.g. PV-P2c
# variant-product redirect: <PUBLIC_PWA_URL>/c/<storeSlug>). Override per
# deployment; defaults to the production PWA domain in code if unset.
PUBLIC_PWA_URL=

# Cloudflare R2 (catalog/profile image storage)
STORAGE_PROVIDER=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Local encryption + Cloudflare Worker
FIELD_ENCRYPTION_KEY=
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_TOKEN=

# Shipping cost provider (RajaOngkir / Komerce)
RAJAONGKIR_API_KEY=
