DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/your_db_name"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"
PORT=3000

# ============================================
# AI Providers Configuration
# ============================================

# Gemini API (Primary)
GEMINI_API_KEY=your-gemini-api-key

# Groq API (Fallback) — multi-key, comma-separated for auto-rotation
GROQ_API_KEYS="key1,key2,key3"

# GOWA (WhatsApp Gateway - Self-hosted, for admin use)
GOWA_API_URL=http://localhost:3001
GOWA_BASIC_AUTH_USER=your-gowa-username
GOWA_BASIC_AUTH_PASS=your-gowa-password

# Cloudinary (Profile Photo Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# Backup System Configuration
# ============================================

# Backup encryption key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BACKUP_ENCRYPTION_KEY=your-64-char-hex-string-here

# Backup storage path (default: /tmp/garuda-backups)
# BACKUP_PATH=/mnt/backups

# Backup provider: local | s3 | gcs | minio
BACKUP_PROVIDER=local

# ============================================
# Cloudflare R2 (Storage gambar katalog & foto profil)
# ============================================
# Provider: "r2" atau "cloudinary". Jika kosong & R2 terkonfigurasi → otomatis R2.
STORAGE_PROVIDER=r2

# ============================================
# Field-Level Encryption (Phase 1.10)
# ============================================
# Kunci enkripsi AES-256-GCM untuk field sensitif (nama customer, HP, alamat, dll).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong → enkripsi DISABLED (passthrough, data plaintext)
# Nanti bisa diganti ke Cloudflare KV / HashiCorp Vault tanpa ganti kode.
FIELD_ENCRYPTION_KEY=

# Cloudflare Account ID (dashboard → R2)
R2_ACCOUNT_ID=your-r2-account-id

# S3 API Token (R2 → Manage R2 API Tokens → Create API Token)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket name
R2_BUCKET=your-bucket-name

# Opsional: public base URL (contoh: https://pub-xxxx.r2.dev atau custom domain)
# Jika kosong, URL yang dihasilkan adalah endpoint S3 (butuh signed URL untuk akses).
R2_PUBLIC_BASE_URL=

# ============================================
# CORS — Web Adapter (PWA) origin whitelist
# ============================================
# Comma-separated daftar origin yang diperbolehkan mengakses endpoint publik
# PWA (/api/pwa/*). Domain ini HARUS eksplisit (JANGAN pakai wildcard "*" —
# wildcard tidak aman bila credentials:true). Set di server production .env asli
# sebelum PWA diluncurkan; jika kosong/unset hanya localhost dev yang diizinkan.
# Contoh nilai: https://qlobot.web.id,https://www.qlobot.web.id
PWA_ALLOWED_ORIGINS=https://qlobot.web.id

# ============================================
# Shipping Cost (RajaOngkir Starter — FOUNDATION, not wired to checkout yet)
# ============================================
# Starter tier = FREE, city-level ONLY (no subdistrict), couriers: jne, pos, tiki.
# NOTE: owner decision — cost results are cached 7 days (RajaOngkir ToS forbids
# this; risk accepted, architecture kept provider-swappable).
RAJAONGKIR_API_KEY=
RAJAONGKIR_DAILY_QUOTA=100

# ============================================
# Web Push — FASE 4 (notification SIGNAL, not transport)
# ============================================
# VAPID keys for server-side web-push. PRIVATE key is server-only — JANGAN commit
# real values ke repo; generate di deploy via:
#   node -e "import('web-push').then(w=>console.log(w.generateVAPIDKeys()))"
# PUBLIC key boleh dikirim ke PWA (client memakai untuk PushManager.subscribe).
# Jika kosong, notification service tetap boot tapi web push DISABLED (WS tetap primary).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mailto subject registered as the VAPID "sub" claim.
VAPID_SUBJECT=mailto:admin@qlobot.local

# Order auto-cancel (PV-P1-08): hours before stuck orders auto-cancel. Default 24h.
ORDER_AUTO_CANCEL_HOURS=24
