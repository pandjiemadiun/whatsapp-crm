          ],
          "mustNotContain": [
            "Rp 0"
          ]
        }
      },
      {
        "msg": "Ongkir berapa",
        "expect": {
          "routeKind": "waterfall",
          "mustContain": [
            "Rp"
          ]
        }
      },
      {
        "msg": "Pakai qris ya",
        "expect": {
          "routeKind": "waterfall",
          "mustNotContain": [
            "siapa nama"
          ]
        }
      }
    ]
  },
