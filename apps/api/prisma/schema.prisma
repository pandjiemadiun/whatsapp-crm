datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String?  @unique
  phoneNumber           String
  // Deterministic hash of phoneNumber for indexed lookup (phoneNumber is
  // encrypted at rest via AES-256-GCM with random IV, so direct WHERE
  // comparison is impossible). Used by the GOWA webhook to resolve the
  // receiving store by bot phone number.
  phoneNumberHash       String?  @unique
  profilePhotoUrl       String?
  description           String?
  businessCategory      String?
  address                String
  // Merchant origin location (RajaOngkir IDs) for shipping-cost origin.
  // Wajib diisi saat registrasi toko (NOT NULL).
  originProvinceId      String
  originProvinceName    String
  originCityId          String
  originCityName        String
  originSubdistrictId   String
  originSubdistrictName String
  email                 String?  @unique
  timezone              String   @default("Asia/Jakarta")
  operatingHours        Json?
  responseTemplate      String?
  whatsappPhoneId       String?
  fonnteToken           String?
  fonnteNumber          String?
  acceptsTransfer       Boolean  @default(false)
  acceptsQris           Boolean  @default(false)
  acceptsCod            Boolean  @default(false)
  qrisImageUrl          String?
  shippingMode          String   @default("pickup")  // "pickup" | "flat"
  shippingFlatInCity    Float?
  shippingFlatOutCity   Float?
  webhookSecret         String?  @unique
  config                Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  conversations         Conversation[]
  faqs                  FAQ[]
  knowledge             Knowledge[]
  storeDocuments        StoreDocument[]
  orders                Order[]
  settings              StoreSetting[]
  productCategories     ProductCategory[]
  products              Product[]
magicPasteRuns        MagicPasteRun[]
  bankAccounts          BankAccount[]
  sops                  Sop[]
  customers             Customer[]
  pushSubscriptions     StorePushSubscription[]

  @@map("stores")
}

model BankAccount {
  id            String    @id @default(uuid())
  storeId       String
  bankName      String
  accountNumber String
  accountName   String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  store         Store     @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("bank_accounts")
}

model Sop {
  id        String   @id @default(uuid())
  storeId   String
  category  String   // fixed values: 'order' | 'komplain' | 'retur' | 'garansi' | 'stok_habis'
  content   String   // free text, owner writes their own procedure
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, category])
  @@index([storeId])
  @@map("sops")
}

model StoreSetting {
  id                    String   @id @default(uuid())
  storeId               String
  key                   String
  value                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  store                 Store    @relation(fields: [storeId], references: [id])
  @@unique([storeId, key])
  @@map("store_settings")
}

model FAQ {
  id                    String   @id @default(uuid())
  storeId               String
  question              String
  answer                String
  keywords              String[]
  category              String?
  priority              Int      @default(1)
  source                String?
  embedding             String?
  matchCount            Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  store                 Store    @relation(fields: [storeId], references: [id])
  @@index([storeId])
  @@map("faqs")
}

model Knowledge {
  id                    String   @id @default(uuid())
  storeId               String
  title                 String
  content               String
  category              String?
  tags                  String[]
  source                String?
  embedding             String?
  relevanceScore        Float    @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  store                 Store    @relation(fields: [storeId], references: [id])
  @@index([storeId])
  @@map("knowledge_base")
}

// PV-P1 — Onboarding Wizard contract §3.1: StoreDocument.
//
// Invariant (enforced in service layer, not DB constraint): rows with
// status='published' must never have `content` updated. Edits after publish
// create a new row (version+1, status='draft'). Max 1 published row per
// (storeId, type) at any time. Enforcement lands in P4 (Review/edit/publish
// flow), NOT this task.
model StoreDocument {
  id                    String              @id @default(uuid())
  storeId               String
  type                  StoreDocumentType
  version               Int                 @default(1)
  content               String
  status                StoreDocumentStatus @default(draft)
  generatedFromAnswers  Json?
  generatedAt           DateTime?
  publishedAt           DateTime?
  editedAt              DateTime            @updatedAt
  createdAt             DateTime            @default(now())

  store                 Store               @relation(fields: [storeId], references: [id])
  orders                Order[]

  @@unique([storeId, type, version])
  @@index([storeId, type, status])
  @@map("store_documents")
}

enum StoreDocumentType {
  tos
  sop
}

enum StoreDocumentStatus {
  draft
  published
  superseded
}

model Conversation {
  id                    String   @id @default(uuid())
  storeId               String
  customerId            String
  customerName          String?
  customerPhone         String?
  status                String   @default("open")
  channel               String   @default("whatsapp")
  lastMessageAt         DateTime?
  aiResponseCount       Int      @default(0)
  faqResponseCount      Int      @default(0)
  humanTakeoverAt       DateTime?
  humanAgentId          String?
  resolvedAt            DateTime?
  notes                 String?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  store                 Store    @relation(fields: [storeId], references: [id])
  history               ConversationHistory[]
  context               ConversationContext?
  orders                Order[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@map("conversations")
}

model ConversationHistory {
  id                    String   @id @default(uuid())
  conversationId        String
  role                  String
  content               String
  messageType           String?
  source                String?
  aiModel               String?
  costUSD               Float    @default(0)
  responseTime          Int?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  conversation          Conversation @relation(fields: [conversationId], references: [id])
  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@index([createdAt, source])
  @@map("conversation_history")
}

model ConversationContext {
  id                    String   @id @default(uuid())
  conversationId        String   @unique
  lastMessages          Json
  extractedEntities     Json?
  workspace_v2          Json?
  userIntent            String?
  sessionKey            String   @unique
  sessionExpireAt       DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  conversation          Conversation @relation(fields: [conversationId], references: [id])
  @@map("conversation_context")
}

model Order {
  id                    String   @id @default(uuid())
  storeId               String
  conversationId        String
  customerId            String
  items                 Json
  totalPrice            Float?
  currency              String   @default("IDR")
  orderStatus           String   @default("pending") // draft | waiting_address | waiting_payment | paid | packing | shipped | pending | cancelled | completed | refunded
  paymentMethod         String?  // 'transfer' | 'qris' | 'cod' (null = not chosen yet / legacy order)
  paymentStatus         String   @default("unpaid") // 'unpaid' | 'pending_verification' | 'paid' | 'rejected'
  paymentProofUrl       String?  // upload bukti transfer/qris oleh customer
  paymentReportedAt     DateTime? // kapan customer melaporkan/submit bukti
  paymentVerifiedAt     DateTime? // kapan admin memverifikasi → paid
  verifiedByAdminId     String?  // id admin/user (plain string; no relation — JANGAN buat model baru)
  paymentRejectReason   String?  // alasan TOLAK opsional (nullable; JANGAN wajibkan) untuk histori/audit
  shippingAddress       String?
  // Destination address (customer shipping target) — additive, optional.
  // Mirrors Store origin fields for naming consistency. Populated by checkout
  // cascading dropdown; free-text `shippingAddress` above stays for street/house detail.
  destinationProvinceId      String?
  destinationProvinceName    String?
  destinationCityId          String?
  destinationCityName        String?
  destinationSubdistrictId   String?
  destinationSubdistrictName String?
  // Actual shipping cost (RajaOngkir Komerce, subdistrict-native). Additive &
  // NULLABLE: legacy orders without a shipping selection stay valid. These are
  // ALWAYS written by the server via CachedShippingCostService — NEVER trusted
  // from a client request body (I13 truth boundary / owner invariant).
  shippingCost        Float?
  selectedCourier     String?
  selectedService     String?
  shippingEtd         String?
  notes                 String?
  extractedAt           DateTime @default(now())
  confirmedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?
  // PV-P1-08: auto-expiry stamp for stuck orders (waiting_address / waiting_payment).
  // Set atomically at checkout (stock decrement); consumed by the 15-min
  // AutoCancel cron. NULL = order under 7-day manual window / terminal state.
  autoCancelAt          DateTime?
  // PV-P1: TOS document captured at checkout (wizard-generated StoreDocument).
  // Nullable — legacy orders have none; no backfill required.
  tosDocumentId         String?
  tosDocument           StoreDocument? @relation(fields: [tosDocumentId], references: [id])

  store                 Store    @relation(fields: [storeId], references: [id])
  conversation          Conversation @relation(fields: [conversationId], references: [id])
  orderItems            OrderItem[]

  @@index([storeId])
  @@index([conversationId])
  @@index([customerId])
  @@index([createdAt])
  @@index([orderStatus, createdAt])
  @@index([orderStatus, autoCancelAt])
  @@map("orders")
}

model OrderItem {
  id                    String   @id @default(uuid())
  orderId               String
  productId             String?
  productName           String   // snapshot nama produk saat order dibuat
  quantity              Int      @default(1)
  unitPrice             Float
  subtotal              Float
  customizations        Json?
  // PV-P0: nullable — diisi oleh CartAuthority di PV-P1 (di luar scope task ini).
  // Row existing = null (item tanpa varian).
  variantId             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order                 Order    @relation(fields: [orderId], references: [id])
  product               Product? @relation(fields: [productId], references: [id])
  variant               ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model ProductCategory {
  id                    String   @id @default(uuid())
  storeId               String
  name                  String
  description           String?
  icon                  String?
  displayOrder          Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  store                 Store    @relation(fields: [storeId], references: [id])
  products              Product[]

  @@index([storeId])
  @@map("product_categories")
}

model Product {
  id                    String   @id @default(uuid())
  storeId               String
  categoryId            String?
  name                  String
  description           String?
  price                 Float
  currency              String   @default("IDR")
  sku                   String?
  stock                 Int?
  // Berat produk dalam gram. 0 = placeholder migration (belum diisi); wajib > 0 di API untuk produk baru.
  weight                Int      @default(0)
  images                Json?
  primaryImageUrl       String?
  isActive              Boolean  @default(true)
  // PV-P0: flag apakah produk punya varian. Default false; di-set true oleh write
  // path di PV-P1 (di luar scope task ini). Semua row existing = false.
  hasVariants           Boolean  @default(false)
  source                String   @default("api") // 'api' | 'magic_paste' | 'import'
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  store                 Store    @relation(fields: [storeId], references: [id])
  category              ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems            OrderItem[]
  variants              ProductVariant[]

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

// ── PV-P0: Product Variants ────────────────────────────────────────────────────
// Model baru untuk product variants (size/warna/dll). Schema-only (PV-P0):
// TIDAK ADA business logic / endpoint. `storeId` di-denormalize dari Product
// agar query per-toko tidak perlu join ke Product. `attributes` Json menyimpan
// pasangan opsi (mis. {"size":"L","color":"red"}) — bentuk bebas, server-authoritative
// di PV-P1. `price` disamakan tipe dengan Product.price (Float).
model ProductVariant {
  id                    String   @id @default(uuid())
  productId             String
  storeId               String
  sku                   String?  // nullable; unik per store (konsisten dgn Product.sku)
  attributes            Json
  price                 Float
  stock                 Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@map("product_variants")
}

// Riwayat eksekusi Magic Paste — dasar analytics confidence (Phase 1.9.6).
// Dicatat setiap kali extraction dijalankan (preview & create, sukses & gagal).
model MagicPasteRun {
  id                  String   @id @default(uuid())
  storeId             String
  productId           String?
  textLength          Int      @default(0)
  confidence          Float    @default(0)
  status              String   @default("success") // 'success' | 'failed' | 'preview'
  warnings            Json?
  extractedEntities   Json?
  source              String   @default("store") // 'store' | 'admin'
  errorMessage        String?
  createdAt           DateTime @default(now())

  store               Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([confidence])
  @@map("magic_paste_runs")
}

model AuditLog {
  id                    String   @id @default(uuid())
  storeId               String
  action                String
  entity                String
  entityId              String
  userId                String?
  changes               Json?
  ipAddress             String?
  createdAt             DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Analytics {
  id                    String   @id @default(uuid())
  storeId               String
  date                  DateTime
  totalMessages         Int      @default(0)
  faqMatches            Int      @default(0)
  aiResponses           Int      @default(0)
  humanTakeovers        Int      @default(0)
  ordersCreated         Int      @default(0)
  costUSD               Float    @default(0)
  avgResponseTime       Float    @default(0)
  createdAt             DateTime @default(now())

  @@unique([storeId, date])
  @@index([storeId])
  @@map("analytics")
}

model AdminUser {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  role          String        @default("support_admin")
  isActive      Boolean       @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  tokens        AdminAuthToken[]

  @@index([email])
  @@index([createdAt])
  @@map("admin_users")
}

model AdminAuthToken {
  id            String        @id @default(uuid())
  adminUserId   String
  token         String        @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())

  adminUser     AdminUser     @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_auth_tokens")
}

model Customer {
  id            String   @id @default(uuid())
  storeId       String
  phone         String?
  webUid        String?  @unique
  pushSubscription Json?  // FASE 4: persistent Web Push subscription (VAPID). server-authoritative; scoped by storeId+webUid (no cross-tenant).
  name          String?
  originCity    String?
  nameSource    String?  // 'self_stated' | 'pushname'
  visitCount    Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  notes         String?
  deletedAt     DateTime?

  store         Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

// Merchant (Store) push subscriptions — one row per subscribed browser/device.
// A store may have multiple tabs/devices subscribed simultaneously.
// Scoped strictly by storeId (tenant isolation).
model StorePushSubscription {
  id          String   @id @default(uuid())
  storeId     String
  endpoint    String
  auth        String
  p256dh      String
  userAgent   String?
  createdAt   DateTime @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, endpoint])
  @@index([storeId])
  @@map("store_push_subscriptions")
}

model SystemSetting {
  id            String    @id @default(uuid())
  key           String    @unique
  value         String
  description   String?
  category      String    @default("general")
  isSecret      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@map("system_settings")
}

model BackupManifest {
  id            String    @id @default(uuid())
  filename      String    @unique
  type          String    // "daily" | "weekly" | "manual" | "file"
  size          BigInt
  checksum      String
  algorithm     String    @default("sha256")
  encrypted     Boolean   @default(true)
  status        String    @default("completed") // "completed" | "failed" | "verifying"
  errorMessage  String?
  verifiedAt    DateTime?
  restoredAt    DateTime?
  restoredBy    String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([createdAt])
  @@index([type])
  @@map("backup_manifest")
}

model ActionIdempotency {
  idempotencyKey String   @id
  storeId        String
  customerId     String
  actionType     String
  actionId       String
  status         String   @default("CLAIMED")
  claimedAt      DateTime
  leaseUntil     DateTime
  result         Json?
  error          Json?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([storeId, customerId, actionType, actionId])
  @@map("action_idempotency")
}
