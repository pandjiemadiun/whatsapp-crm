generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                    String                  @id @default(uuid())
  name                  String
  phoneNumber           String
  profilePhotoUrl       String?
  description           String?
  businessCategory      String?
  address               String
  email                 String?                 @unique
  timezone              String                  @default("Asia/Jakarta")
  operatingHours        Json?
  responseTemplate      String?
  whatsappPhoneId       String?
  fonnteToken           String?
  fonnteNumber          String?
  config                Json?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  acceptsCod            Boolean                 @default(false)
  acceptsQris           Boolean                 @default(false)
  acceptsTransfer       Boolean                 @default(false)
  webhookSecret         String?                 @unique
  qrisImageUrl          String?
  shippingMode          String                  @default("pickup")
  shippingFlatInCity    Float?
  shippingFlatOutCity   Float?
  slug                  String?                 @unique
  originProvinceId      String
  originProvinceName    String
  originCityId          String
  originCityName        String
  originSubdistrictId   String
  originSubdistrictName String
  phoneNumberHash       String?                 @unique
  bankAccounts          BankAccount[]
  conversations         Conversation[]
  customers             Customer[]
  faqs                  FAQ[]
  knowledge             Knowledge[]
  magicPasteRuns        MagicPasteRun[]
  orders                Order[]
  productCategories     ProductCategory[]
  products              Product[]
  sops                  Sop[]
  storeDocuments        StoreDocument[]
  pushSubscriptions     StorePushSubscription[]
  settings              StoreSetting[]

  @@map("stores")
}

model BankAccount {
  id            String    @id @default(uuid())
  storeId       String
  bankName      String
  accountNumber String
  accountName   String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  store         Store     @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("bank_accounts")
}

model Sop {
  id        String   @id @default(uuid())
  storeId   String
  category  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, category])
  @@index([storeId])
  @@map("sops")
}

model StoreSetting {
  id        String   @id @default(uuid())
  storeId   String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, key])
  @@map("store_settings")
}

model FAQ {
  id         String    @id @default(uuid())
  storeId    String
  question   String
  answer     String
  keywords   String[]
  category   String?
  priority   Int       @default(1)
  embedding  String?
  matchCount Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  source     String?
  store      Store     @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("faqs")
}

model Knowledge {
  id             String    @id @default(uuid())
  storeId        String
  title          String
  content        String
  category       String?
  tags           String[]
  source         String?
  embedding      String?
  relevanceScore Float     @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  store          Store     @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("knowledge_base")
}

model StoreDocument {
  id                   String              @id @default(uuid())
  storeId              String
  type                 StoreDocumentType
  version              Int                 @default(1)
  content              String
  status               StoreDocumentStatus @default(draft)
  generatedFromAnswers Json?
  generatedAt          DateTime?
  publishedAt          DateTime?
  editedAt             DateTime            @updatedAt
  createdAt            DateTime            @default(now())
  orders               Order[]
  store                Store               @relation(fields: [storeId], references: [id])

  @@unique([storeId, type, version])
  @@index([storeId, type, status])
  @@map("store_documents")
}

model Conversation {
  id               String                @id @default(uuid())
  storeId          String
  customerId       String
  customerName     String?
  customerPhone    String?
  status           String                @default("open")
  channel          String                @default("whatsapp")
  lastMessageAt    DateTime?
  aiResponseCount  Int                   @default(0)
  faqResponseCount Int                   @default(0)
  humanTakeoverAt  DateTime?
  humanAgentId     String?
  resolvedAt       DateTime?
  notes            String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  context          ConversationContext?
  history          ConversationHistory[]
  store            Store                 @relation(fields: [storeId], references: [id])
  orders           Order[]

  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@map("conversations")
}

model ConversationHistory {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  messageType    String?
  source         String?
  aiModel        String?
  costUSD        Float        @default(0)
  responseTime   Int?
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@index([createdAt, source])
  @@map("conversation_history")
}

model ConversationContext {
  id                String       @id @default(uuid())
  conversationId    String       @unique
  lastMessages      Json
  extractedEntities Json?
  userIntent        String?
  sessionKey        String       @unique
  sessionExpireAt   DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  workspace_v2      Json?
  conversation      Conversation @relation(fields: [conversationId], references: [id])

  @@map("conversation_context")
}

model Order {
  id                         String         @id @default(uuid())
  storeId                    String
  conversationId             String
  customerId                 String
  items                      Json
  totalPrice                 Float?
  currency                   String         @default("IDR")
  orderStatus                String         @default("pending")
  shippingAddress            String?
  notes                      String?
  extractedAt                DateTime       @default(now())
  confirmedAt                DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  deletedAt                  DateTime?
  paymentMethod              String?
  paymentProofUrl            String?
  paymentReportedAt          DateTime?
  paymentStatus              String         @default("unpaid")
  paymentVerifiedAt          DateTime?
  verifiedByAdminId          String?
  paymentRejectReason        String?
  destinationProvinceId      String?
  destinationProvinceName    String?
  destinationCityId          String?
  destinationCityName        String?
  destinationSubdistrictId   String?
  destinationSubdistrictName String?
  shippingCost               Float?
  selectedCourier            String?
  selectedService            String?
  shippingEtd                String?
  autoCancelAt               DateTime?
  tosDocumentId              String?
  orderItems                 OrderItem[]
  conversation               Conversation   @relation(fields: [conversationId], references: [id])
  store                      Store          @relation(fields: [storeId], references: [id])
  tosDocument                StoreDocument? @relation(fields: [tosDocumentId], references: [id])

  @@index([storeId])
  @@index([conversationId])
  @@index([customerId])
  @@index([createdAt])
  @@index([orderStatus, createdAt])
  @@index([orderStatus, autoCancelAt])
  @@map("orders")
}

model OrderItem {
  id             String          @id @default(uuid())
  orderId        String
  productId      String?
  productName    String
  quantity       Int             @default(1)
  unitPrice      Float
  subtotal       Float
  customizations Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  variantId      String?
  order          Order           @relation(fields: [orderId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model ProductCategory {
  id           String    @id @default(uuid())
  storeId      String
  name         String
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  store        Store     @relation(fields: [storeId], references: [id])
  products     Product[]

  @@index([storeId])
  @@map("product_categories")
}

model Product {
  id              String           @id @default(uuid())
  storeId         String
  categoryId      String?
  name            String
  description     String?
  price           Float
  currency        String           @default("IDR")
  sku             String?
  stock           Int?
  images          Json?
  primaryImageUrl String?
  isActive        Boolean          @default(true)
  source          String           @default("api")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  weight          Int              @default(0)
  hasVariants     Boolean          @default(false)
  orderItems      OrderItem[]
  variants        ProductVariant[]
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  store           Store            @relation(fields: [storeId], references: [id])

  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  storeId    String
  sku        String?
  attributes Json
  price      Float
  stock      Int?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storeId, sku])
  @@index([productId])
  @@map("product_variants")
}

model MagicPasteRun {
  id                String   @id @default(uuid())
  storeId           String
  productId         String?
  textLength        Int      @default(0)
  confidence        Float    @default(0)
  status            String   @default("success")
  warnings          Json?
  extractedEntities Json?
  source            String   @default("store")
  errorMessage      String?
  createdAt         DateTime @default(now())
  store             Store    @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([confidence])
  @@map("magic_paste_runs")
}

model AuditLog {
  id        String   @id @default(uuid())
  storeId   String
  action    String
  entity    String
  entityId  String
  userId    String?
  changes   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Analytics {
  id              String   @id @default(uuid())
  storeId         String
  date            DateTime
  totalMessages   Int      @default(0)
  faqMatches      Int      @default(0)
  aiResponses     Int      @default(0)
  humanTakeovers  Int      @default(0)
  ordersCreated   Int      @default(0)
  costUSD         Float    @default(0)
  avgResponseTime Float    @default(0)
  createdAt       DateTime @default(now())

  @@unique([storeId, date])
  @@index([storeId])
  @@map("analytics")
}

model AdminUser {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  role         String           @default("support_admin")
  isActive     Boolean          @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  tokens       AdminAuthToken[]

  @@index([email])
  @@index([createdAt])
  @@map("admin_users")
}

model AdminAuthToken {
  id          String    @id @default(uuid())
  adminUserId String
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_auth_tokens")
}

model Customer {
  id               String    @id @default(uuid())
  storeId          String
  phone            String?
  name             String?
  originCity       String?
  nameSource       String?
  visitCount       Int       @default(0)
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  notes            String?
  deletedAt        DateTime?
  webUid           String?   @unique
  pushSubscription Json?
  store            Store     @relation(fields: [storeId], references: [id])

  @@unique([storeId, phone])
  @@index([storeId])
  @@map("customers")
}

model StorePushSubscription {
  id        String   @id @default(uuid())
  storeId   String
  endpoint  String
  auth      String
  p256dh    String
  userAgent String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, endpoint])
  @@index([storeId])
  @@map("store_push_subscriptions")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   @default("general")
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("system_settings")
}

model AIProviderConfig {
  id             String    @id @default(uuid())
  name           String
  format         String
  baseUrl        String
  apiKey         String
  model          String
  role           String
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  lastTestedAt   DateTime?
  lastTestResult String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  authType       String    @default("bearer")
  password       String?
  username       String?
  skipParams     Json?

  @@index([role, isActive, priority])
  @@map("ai_provider_configs")
}

model V2ShadowLog {
  id              String   @id @default(uuid())
  storeId         String
  conversationId  String
  customerMessage String
  v1ActualReply   String
  v2Output        Json
  v2EnrichedReply String?  // reply_text after system-enrichment (with prices from CartAuthority)
  /// V2-rewrite shadow columns (WIRE-V2ENGINE-ENTRYPOINT)
  v2DerivedReason      String?  // reason from deriveV2EngineReason
  v2MessageType        String?  // classifyStructured messageType from V2 rewrite
  v2ProductSource      Json?    // product source + metadata from deriveV2EngineProductSource
  v2QuickReply         Json?    // quick_reply {reason, question} from deriveV2EngineQuickReply
  createdAt       DateTime @default(now())

  @@index([storeId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("v2_shadow_logs")
}

model TokenUsageLog {
  id           String   @id @default(uuid())
  provider     String
  role         String?
  model        String?
  inputTokens  Int
  outputTokens Int
  costUsd      Float?
  source       String?
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("token_usage_logs")
}

model BackupManifest {
  id           String    @id @default(uuid())
  filename     String    @unique
  type         String
  size         BigInt
  checksum     String
  algorithm    String    @default("sha256")
  encrypted    Boolean   @default(true)
  status       String    @default("completed")
  errorMessage String?
  verifiedAt   DateTime?
  restoredAt   DateTime?
  restoredBy   String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([type])
  @@map("backup_manifest")
}

model ActionIdempotency {
  idempotencyKey String    @id
  storeId        String
  customerId     String
  actionType     String
  actionId       String
  status         String    @default("CLAIMED")
  result         Json?
  error          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?
  leaseUntil     DateTime
  claimedAt      DateTime

  @@unique([storeId, customerId, actionType, actionId])
  @@map("action_idempotency")
}

enum StoreDocumentType {
  tos
  sop
}

enum StoreDocumentStatus {
  draft
  published
  superseded
}
